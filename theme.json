				{
					"slug": "border",
					"name": "Hairline",
					"color": "#419fb83b"
				},
				{
					"slug": "border-strong",
					"name": "Control border",
					"color": "#3a95aa"
				},
				{
					"slug": "mist",
					"name": "Mist",
					"color": "#f2f7f8"
				},
				{
					"slug": "mist-deep",
