{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Chips",
	"slug": "list-chips",
	"blockTypes": [ "core/list" ],
	"styles": {
		"spacing": { "padding": { "left": "0" } },
		"typography": { "fontSize": "var:preset|font-size|small", "fontWeight": "500" },
		"css": "list-style:none;display:flex;flex-wrap:wrap;gap:.5rem;& li{margin:0;padding:.45rem .9rem;border:1px solid var(--wp--preset--color--border-strong);border-radius:var(--wp--custom--radius--pill);color:var(--wp--preset--color--contrast);line-height:1.3}& li::marker{content:none}"
	}
}
